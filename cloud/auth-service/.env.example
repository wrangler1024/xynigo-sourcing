# Copy to .env on the server and replace every placeholder. Never commit .env.
POSTGRES_DB=xynigo_identity
POSTGRES_USER=xynigo_auth
POSTGRES_PASSWORD=replace-with-a-long-random-password

XYNIGO_AUTH_ENVIRONMENT=production
XYNIGO_AUTH_DATABASE_URL=postgresql+psycopg://xynigo_auth:replace-with-a-long-random-password@db:5432/xynigo_identity
# Generate once per environment with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store only in the root-owned .env; rotating this key requires a controlled re-encryption migration.
XYNIGO_AUTH_BUYER_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
XYNIGO_AUTH_FEISHU_APP_ID=cli_replace_me
XYNIGO_AUTH_FEISHU_APP_SECRET=replace-me
XYNIGO_AUTH_FEISHU_REDIRECT_URI=https://xynigo.example.com/v1/auth/feishu/callback
# Prefer S256. Use plain/disabled only as a documented Feishu compatibility fallback.
XYNIGO_AUTH_FEISHU_PKCE_METHOD=S256

# Independent test Base mirrors for real shared-test operations.
XYNIGO_AUTH_FEISHU_OPERATION_SYNC_ENABLED=false
XYNIGO_AUTH_FEISHU_OPERATION_BASE_TOKEN=Rzc_replace_me
XYNIGO_AUTH_FEISHU_BUYER_ACCOUNT_TABLE_ID=tbl_replace_me
XYNIGO_AUTH_FEISHU_ENVIRONMENT_RESULT_TABLE_ID=tbl_replace_me
XYNIGO_AUTH_FEISHU_LOGISTICS_RESULT_TABLE_ID=tbl_replace_me
XYNIGO_AUTH_FEISHU_OPERATION_SYNC_INTERVAL_SECONDS=15

# PostgreSQL-authoritative purchase task mirror. Keep disabled until the 38/59
# field preflight passes against the approved purchase Base.
XYNIGO_AUTH_FEISHU_PURCHASE_SYNC_ENABLED=false
XYNIGO_AUTH_FEISHU_PURCHASE_BASE_TOKEN=Rzc_replace_me
XYNIGO_AUTH_FEISHU_PURCHASE_ORDER_TABLE_ID=tbl_replace_me
XYNIGO_AUTH_FEISHU_PURCHASE_LINE_TABLE_ID=tbl_replace_me
XYNIGO_AUTH_FEISHU_PURCHASE_SYNC_INTERVAL_SECONDS=15

# Cloud-native "小犀助手 → 采购协作导入". Keep disabled until the Feishu
# application has sheets:spreadsheet and the target ordinary Sheet explicitly
# adds the application as an editable document app.
XYNIGO_AUTH_PROCUREMENT_IMPORT_ENABLED=false
XYNIGO_AUTH_PROCUREMENT_IMPORT_PLAN_TTL_SECONDS=1800
XYNIGO_AUTH_PROCUREMENT_IMPORT_WORKER_INTERVAL_SECONDS=2
XYNIGO_AUTH_PROCUREMENT_IMPORT_MAX_ACTIVE_PLANS_PER_TENANT=5

# Comma-separated allowlists. Do not use a "first user becomes admin" rule.
XYNIGO_AUTH_ALLOWED_TENANT_KEYS=replace-with-feishu-tenant-key
XYNIGO_AUTH_BOOTSTRAP_SUPER_ADMIN_OPEN_IDS=replace-with-approved-open-id
XYNIGO_AUTH_AUTO_ACTIVATE_USERS=false

XYNIGO_AUTH_SESSION_TTL_SECONDS=28800
XYNIGO_AUTH_COOKIE_NAME=xynigo_session
XYNIGO_AUTH_COOKIE_SECURE=true
XYNIGO_AUTH_LOGIN_SUCCESS_PATH=/
XYNIGO_AUTH_ALLOWED_HOSTS=xynigo.example.com,127.0.0.1,localhost
