  "cards": [
    {
      "dot": "cyan",
      "title": "统一入口原则",
      "items": [
        "云端 Web 是唯一用户界面，本机执行器不再承担完整业务 UI",
        "浏览器只访问同源云端 API，不把 localhost 直连作为主链路",
        "执行器离线时云端读取功能可用，本机操作明确暂停"
      ]
    },
    {
      "dot": "emerald",
      "title": "轮询与租约",
      "items": [
        "空闲长轮询 20–25 秒，服务端有任务立即返回，避免固定 1.5 秒刷接口",
        "任务领取使用 lease_until、attempt、幂等键和 payload_version",
        "断网或重启只重领安全任务；外部结果不确定必须人工接管"
      ]
    },
    {
      "dot": "amber",
      "title": "本地配置边界",
      "items": [
        "config.json 继续是本机事实源，云端不保存完整副本",
        "设置指令仅对在线目标设备生效，并使用 expectedRevision 防覆盖",
        "代理链接与应用 Secret 不进入普通任务日志或响应"
      ]
    },
    {
      "dot": "rose",
      "title": "上线闸门",
      "items": [
        "先用合成执行器完成配对、撤销、断网、重放和租约过期测试",
        "再用 Windows/macOS 各一台设备灰度配置读写，不开放真实下单",
        "设备通道可单独关闭，本地兼容入口和原配置必须可回退"
      ]
    }
  ]
}
